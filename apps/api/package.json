{
  "name": "@ai-review/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API surface that hosts the shared review pipeline for the Web and Desktop UIs.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "start": "tsx src/index.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ai-review/core": "*",
    "@ai-review/llm": "*",
    "@ai-review/orchestrator": "*",
    "@ai-review/shared": "*",
    "@ai-review/context-engine": "*",
    "@ai-review/agent-runtime": "*",
    "@ai-review/memory": "*",
    "@ai-review/workflow-engine": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
